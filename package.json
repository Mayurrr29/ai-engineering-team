{
  "name": "ai-engineering-team",
  "version": "0.2.0",
  "description": "An AI engineering team for your repo, led by JARVIS: it sizes each task, staffs PM, architect, developer, QA, bug fixer, security and code review as needed, enforces code-level gates, and produces a visual mission report.",
  "homepage": "https://github.com/Mayurrr29/ai-engineering-team#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mayurrr29/ai-engineering-team.git"
  },
  "bugs": {
    "url": "https://github.com/Mayurrr29/ai-engineering-team/issues"
  },
  "type": "module",
  "bin": {
    "ai-team": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/orchestrator.test.ts test/units.test.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "ai",
    "agents",
    "multi-agent",
    "claude",
    "claude-code",
    "claude-agent-sdk",
    "code-review",
    "security-review",
    "qa",
    "jarvis",
    "developer-tools",
    "cli",
    "workflow"
  ],
  "author": "Mayur",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.293",
    "commander": "^14.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
